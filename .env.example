# HuggingFace Inference API key — used for all LLM calls via LangChain
HUGGINGFACE_API_KEY=

# HuggingFace model repo ID — any chat model hosted on the Inference API
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# HuggingFace Inference provider — required for third-party providers (e.g. featherless-ai, together, novita)
# Leave unset to use HuggingFace's own inference infrastructure
LLM_PROVIDER=

# LangSmith API key — used for tracing every node in the LangGraph pipeline
LANGSMITH_API_KEY=

# LangSmith project name — groups all traces for this service
LANGSMITH_PROJECT=research-agent

# MinIO endpoint — internal address used by backend services inside Docker
MINIO_ENDPOINT=http://minio:9000

# MinIO public endpoint — host-accessible address embedded in presigned URLs returned to clients
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# MinIO root credentials (also set as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in the container)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO bucket name — created automatically by minio-init on first run
MINIO_BUCKET=research-reports

# Redis connection URL — used by both Celery broker and result backend
REDIS_URL=redis://redis:6379/0

# Runtime environment — set to "production" to restrict CORS origins
ENVIRONMENT=development

# Frontend API base URL — consumed by Vite at build time
VITE_API_URL=http://localhost:8000
